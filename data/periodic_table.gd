static var _cache: Array = []


static func entries() -> Array:
	if _cache.is_empty():
		for row in DATA:
			_cache.append({"z": row[0], "symbol": row[1], "name": row[2], "col": row[3], "row": row[4], "category": row[5]})
	return _cache


static func symbols() -> PackedStringArray:
	var out := PackedStringArray()
	for entry in entries():
		out.append(str(entry["symbol"]))
	return out
